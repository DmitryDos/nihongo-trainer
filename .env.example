# Ключ Claude API. Получить: https://console.anthropic.com → Settings → API keys → Create Key
# Скопируй этот файл в .env.local и вставь ключ (он не попадает в браузер и не коммитится).
ANTHROPIC_API_KEY=

# Модель для генерации текстов и «level up». По умолчанию — Sonnet 4.6.
ANTHROPIC_MODEL=claude-sonnet-4-6
